#dsnextm155 nextminus     sNaN88 -> NaN88  Invalid_operation
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dsnextm156 nextminus     -NaN -> -NaN
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dsnextm157 nextminus     -sNaN -> -NaN  Invalid_operation
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dsnextm158 nextminus     -NaN77 -> -NaN77
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dsnextm159 nextminus     -sNaN88 -> -NaN88  Invalid_operation

-- Nmax, Nmin, Ntiny, subnormals
dsnextm170 nextminus     9.999999E+96 -> 9.999998E+96
dsnextm171 nextminus     9.999998E+96 -> 9.999997E+96
dsnextm172 nextminus     1E-96 -> 9.9999E-97
dsnextm173 nextminus     1.000000E-96 -> 9.9999E-97
dsnextm174 nextminus     9E-100 -> 8.9E-100
dsnextm175 nextminus     9.9E-99 -> 9.89E-99
dsnextm176 nextminus     9.999999E-97 -> 9.9999E-97
dsnextm177 nextminus     9.999999E-96 -> 9.99999E-96
dsnextm178 nextminus     9.999998E-96 -> 9.99999E-96
dsnextm179 nextminus     9.999997E-96 -> 9.99999E-96
dsnextm180 nextminus     0E-100 -> -1E-101
dsnextm181 nextminus     1E-100 -> 9E-101
dsnextm182 nextminus     2E-100 -> 1.9E-100

dsnextm183 nextminus     -0E-100 -> -1E-101
dsnextm184 nextminus     -1E-100 -> -1.1E-100
dsnextm185 nextminus     -2E-100 -> -2.1E-100
dsnextm186 nextminus     -10E-100 -> -1.01E-99
dsnextm187 nextminus     -100E-100 -> -1.001E-98
dsnextm188 nextminus     -100000E-100 -> -1.000001E-95
dsnextm189 nextminus     -1.000000E-96 -> -1.00001E-96
dsnextm190 nextminus     -1.000000E-96 -> -1.00001E-96
dsnextm191 nextminus     -1E-96 -> -1.00001E-96
dsnextm192 nextminus     -9.999998E+96 -> -9.999999E+96
dsnextm193 nextminus     -9.999999E+96 -> -Infinity

-- Null tests
