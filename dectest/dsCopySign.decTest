------------------------------------------------------------------------
-- dsCopySign.decTest                                                 --
-- Generated for Boost.Decimal from ddCopySign.decTest                --
-- The IBM suite ships no ds arithmetic files: decSingle is a         --
-- storage-only format in decNumber, so decimal32 has never had a     --
-- conformance test of its own rounding, overflow and subnormal       --
-- boundaries, which sit at precision 7 / Emax 96 / Emin -95.         --
--                                                                    --
-- This file is ddCopySign narrowed to that context, with             --
-- every expected result and condition recomputed for it.             --
--                                                                    --
-- Generated file. Regenerate with:                                   --
--   tools/generate_ds.py --emit                                      --
--                                                                    --
-- Derived from the General Decimal Arithmetic testcases,             --
-- Copyright (c) Mike Cowlishaw 1981, 2010 and IBM Corporation        --
-- 1981, 2008. See http://speleotrove.com/decimal                     --
------------------------------------------------------------------------
version: 2.62

extended:    1
clamp:       1
precision:   7
maxExponent: 96
minExponent: -95
rounding:    half_even


-- All operands and results are decDoubles.
rounding:    half_even

-- Sanity check
dscps001   copysign      +7.50 11 -> 7.50

-- Infinities
dscps011   copysign      Infinity 11 -> Infinity
dscps012   copysign      -Infinity 11 -> Infinity

-- NaNs, 0 payload
dscps021   copysign      NaN 11 -> NaN
dscps022   copysign      -NaN 11 -> NaN
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps023   copysign      sNaN 11 -> sNaN
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps024   copysign      -sNaN 11 -> sNaN

-- NaNs, non-0 payload
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps031   copysign      NaN10 11 -> NaN10
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps032   copysign      -NaN10 11 -> NaN10
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps033   copysign      sNaN10 11 -> sNaN10
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps034   copysign      -sNaN10 11 -> sNaN10
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps035   copysign      NaN7 11 -> NaN7
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps036   copysign      -NaN7 11 -> NaN7
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps037   copysign      sNaN101 11 -> sNaN101
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps038   copysign      -sNaN101 11 -> sNaN101

-- finites
dscps101   copysign      7 11 -> 7
dscps102   copysign      -7 11 -> 7
dscps103   copysign      75 11 -> 75
dscps104   copysign      -75 11 -> 75
dscps105   copysign      7.50 11 -> 7.50
dscps106   copysign      -7.50 11 -> 7.50
dscps107   copysign      7.500 11 -> 7.500
dscps108   copysign      -7.500 11 -> 7.500

-- zeros
dscps111   copysign      0 11 -> 0
dscps112   copysign      -0 11 -> 0
dscps113   copysign      0E+1 11 -> 0E+1
dscps114   copysign      -0E+1 11 -> 0E+1
dscps115   copysign      0.0000 11 -> 0.0000
dscps116   copysign      -0.0000 11 -> 0.0000
dscps117   copysign      0E-35 11 -> 0E-35
dscps118   copysign      -0E-35 11 -> 0E-35

-- full coefficients, alternating bits
dscps121   copysign      2682682 11 -> 2682682
dscps122   copysign      -2682682 11 -> 2682682
dscps123   copysign      1341341 11 -> 1341341
dscps124   copysign      -1341341 11 -> 1341341

-- Nmax, Nmin, Ntiny
dscps131   copysign      9.999999E+96 11 -> 9.999999E+96
dscps132   copysign      1E-96 11 -> 1E-96
dscps133   copysign      1.000000E-96 11 -> 1.000000E-96
dscps134   copysign      1E-100 11 -> 1E-100

dscps135   copysign      -1E-100 11 -> 1E-100
dscps136   copysign      -1.000000E-96 11 -> 1.000000E-96
dscps137   copysign      -1E-96 11 -> 1E-96
dscps138   copysign      -9.999999E+96 11 -> 9.999999E+96

-- repeat with negative RHS

-- Infinities
dscps211   copysign      Infinity -34 -> -Infinity
dscps212   copysign      -Infinity -34 -> -Infinity

-- NaNs, 0 payload
# BOOST_DECIMAL_DIVERGENCE: IEEE 754 does not interpret the sign of a NaN, so Boost.Decimal neither propagates it nor quiets a signalling NaN through arithmetic
#dscps221   copysign      NaN -34 -> -NaN
