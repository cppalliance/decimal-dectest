-- finites
dscps301   copysign      7 -34 -> -7
dscps302   copysign      -7 -34 -> -7
dscps303   copysign      75 -34 -> -75
dscps304   copysign      -75 -34 -> -75
dscps305   copysign      7.50 -34 -> -7.50
dscps306   copysign      -7.50 -34 -> -7.50
dscps307   copysign      7.500 -34 -> -7.500
dscps308   copysign      -7.500 -34 -> -7.500

-- zeros
dscps311   copysign      0 -34 -> -0
dscps312   copysign      -0 -34 -> -0
dscps313   copysign      0E+1 -34 -> -0E+1
dscps314   copysign      -0E+1 -34 -> -0E+1
dscps315   copysign      0.0000 -34 -> -0.0000
dscps316   copysign      -0.0000 -34 -> -0.0000
dscps317   copysign      0E-35 -34 -> -0E-35
dscps318   copysign      -0E-35 -34 -> -0E-35

-- full coefficients, alternating bits
dscps321   copysign      2682682 -34 -> -2682682
dscps322   copysign      -2682682 -34 -> -2682682
dscps323   copysign      1341341 -34 -> -1341341
dscps324   copysign      -1341341 -34 -> -1341341

-- Nmax, Nmin, Ntiny
dscps331   copysign      9.999999E+96 -34 -> -9.999999E+96
dscps332   copysign      1E-96 -34 -> -1E-96
dscps333   copysign      1.000000E-96 -34 -> -1.000000E-96
dscps334   copysign      1E-100 -34 -> -1E-100

dscps335   copysign      -1E-100 -34 -> -1E-100
dscps336   copysign      -1.000000E-96 -34 -> -1.000000E-96
dscps337   copysign      -1E-96 -34 -> -1E-96
dscps338   copysign      -9.999999E+96 -34 -> -9.999999E+96

-- Other kinds of RHS
dscps401   copysign      701 -34 -> -701
dscps402   copysign      -720 -34 -> -720
dscps403   copysign      701 -0 -> -701
dscps404   copysign      -720 -0 -> -720
dscps405   copysign      701 +0 -> 701
dscps406   copysign      -720 +0 -> 720
dscps407   copysign      701 +34 -> 701
dscps408   copysign      -720 +34 -> 720

dscps413   copysign      701 -Inf -> -701
dscps414   copysign      -720 -Inf -> -720
dscps415   copysign      701 +Inf -> 701
dscps416   copysign      -720 +Inf -> 720

dscps420   copysign      701 -NaN -> -701
