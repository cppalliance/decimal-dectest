dsscb011   scaleb        -7.50 1 -> -75.0
dsscb012   scaleb        -7.50 0 -> -7.50
dsscb013   scaleb        -7.50 -1 -> -0.750

-- Infinities
dsscb014   scaleb        Infinity 1 -> Infinity
dsscb015   scaleb        -Infinity 2 -> -Infinity
dsscb016   scaleb        Infinity -1 -> Infinity
dsscb017   scaleb        -Infinity -2 -> -Infinity

-- Next two are somewhat undefined in 754r; treat as non-integer
dsscb018   scaleb        10 Infinity -> NaN  Invalid_operation
dsscb019   scaleb        10 -Infinity -> NaN  Invalid_operation

-- NaNs are undefined in 754r; assume usual processing
