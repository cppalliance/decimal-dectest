-- examples
rounding:    half_up
dsintx200  tointegralx   2.1 -> 2  Inexact Rounded
dsintx201  tointegralx   100 -> 100
dsintx202  tointegralx   100.0 -> 100  Rounded
dsintx203  tointegralx   101.5 -> 102  Inexact Rounded
dsintx204  tointegralx   -101.5 -> -102  Inexact Rounded
dsintx205  tointegralx   10E+1 -> 1.0E+2
dsintx206  tointegralx   7.89E+19 -> 7.89E+19
dsintx207  tointegralx   -Inf -> -Infinity


-- all rounding modes
rounding:    half_even
dsintx210  tointegralx   55.5 -> 56  Inexact Rounded
dsintx211  tointegralx   56.5 -> 56  Inexact Rounded
dsintx212  tointegralx   57.5 -> 58  Inexact Rounded
dsintx213  tointegralx   -55.5 -> -56  Inexact Rounded
dsintx214  tointegralx   -56.5 -> -56  Inexact Rounded
