------------------------------------------------------------------------
-- dsMultiply.decTest                                                 --
-- Generated for Boost.Decimal from ddMultiply.decTest                --
-- The IBM suite ships no ds arithmetic files: decSingle is a         --
-- storage-only format in decNumber, so decimal32 has never had a     --
-- conformance test of its own rounding, overflow and subnormal       --
-- boundaries, which sit at precision 7 / Emax 96 / Emin -95.         --
--                                                                    --
-- This file is ddMultiply narrowed to that context, with             --
-- every expected result and condition recomputed for it.             --
--                                                                    --
-- Generated file. Regenerate with:                                   --
--   tools/generate_ds.py --emit                                      --
--                                                                    --
-- Derived from the General Decimal Arithmetic testcases,             --
-- Copyright (c) Mike Cowlishaw 1981, 2010 and IBM Corporation        --
-- 1981, 2008. See http://speleotrove.com/decimal                     --
------------------------------------------------------------------------
version: 2.62

extended:    1
clamp:       1
precision:   7
maxExponent: 96
minExponent: -95
rounding:    half_even


-- This set of tests are for decDoubles only; all arguments are
-- representable in a decDouble
rounding:    half_even

-- sanity checks
dsmul000   multiply      2 2 -> 4
dsmul001   multiply      2 3 -> 6
dsmul002   multiply      5 1 -> 5
dsmul003   multiply      5 2 -> 10
dsmul004   multiply      1.20 2 -> 2.40
dsmul005   multiply      1.20 0 -> 0.00
dsmul006   multiply      1.20 -2 -> -2.40
dsmul007   multiply      -1.20 2 -> -2.40
dsmul008   multiply      -1.20 0 -> -0.00
dsmul009   multiply      -1.20 -2 -> 2.40
dsmul010   multiply      5.09 7.1 -> 36.139
dsmul011   multiply      2.5 4 -> 10.0
dsmul012   multiply      2.50 4 -> 10.00
dsmul013   multiply      1.234569 1.000000 -> 1.234569  Rounded
dsmul015   multiply      2.50 4 -> 10.00
dsmul016   multiply      9.999999 9.999999 -> 99.99998  Inexact Rounded
dsmul017   multiply      9.999999 -9.999999 -> -99.99998  Inexact Rounded
dsmul018   multiply      -9.999999 9.999999 -> -99.99998  Inexact Rounded
dsmul019   multiply      -9.999999 -9.999999 -> 99.99998  Inexact Rounded

