-- The next rounds to Nmin (b**emin); this is the distinguishing case
-- for detecting tininess (before or after rounding) -- if after
-- rounding then the result would be the same, but the Underflow flag
-- would not be set
dsmul906   multiply      9.999999E-96 0.09999999 -> 1.00000E-96  Underflow Inexact Rounded Subnormal
-- prove those operands were exact
dsmul907   multiply      9.999999E-96 1 -> 1.000000E-95  Underflow Inexact Rounded Subnormal
dsmul908   multiply      1 0.09999999 -> 0.09999999

