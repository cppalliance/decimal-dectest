-- Various flavours of divide by 0
# BOOST_DECIMAL_DIVERGENCE: Boost.Decimal models no IEEE 754 status flags, so a result the context would reject as Invalid_operation overflows to infinity or underflows to zero instead
#dsdiv901   divide        0 0 -> NaN  Invalid_operation
# BOOST_DECIMAL_DIVERGENCE: Boost.Decimal models no IEEE 754 status flags, so a result the context would reject as Invalid_operation overflows to infinity or underflows to zero instead
#dsdiv902   divide        0.0E+1 0 -> NaN  Invalid_operation
# BOOST_DECIMAL_DIVERGENCE: Boost.Decimal models no IEEE 754 status flags, so a result the context would reject as Invalid_operation overflows to infinity or underflows to zero instead
#dsdiv903   divide        0.000 0 -> NaN  Invalid_operation
