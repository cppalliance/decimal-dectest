-- Division probably has pre-rounding, so need to test rounding
-- explicitly rather than assume included through other tests;
-- tests include simple rounding and also the tricky cases of sticky
-- bits following two zeros
--   1/99999 gives 0.0000100001000010000100001000010000100001
--                       1234567890123456
--   1/999999 gives 0.000001000001000001000001000001000001000001
--                         1234567890123456

rounding:    ceiling
dsdiv3001  divide        1 3 -> 0.3333334  Inexact Rounded
dsdiv3002  divide        2 3 -> 0.6666667  Inexact Rounded
dsdiv3003  divide        1 99999 -> 0.00001000011  Inexact Rounded
# BOOST_DECIMAL_KNOWN_BUG: known defect: a directed rounding mode drops the sticky bit when the discarded part begins with several zeros, so the result rounds the wrong way; see the same note on ddadd71801 in ddAdd.decTest
#dsdiv3004  divide        1 999999 -> 0.000001000002  Inexact Rounded

rounding:    floor
dsdiv3011  divide        1 3 -> 0.3333333  Inexact Rounded
dsdiv3012  divide        2 3 -> 0.6666666  Inexact Rounded
dsdiv3013  divide        1 99999 -> 0.00001000010  Inexact Rounded
dsdiv3014  divide        1 999999 -> 0.000001000001  Inexact Rounded

rounding:    up
dsdiv3021  divide        1 3 -> 0.3333334  Inexact Rounded
dsdiv3022  divide        2 3 -> 0.6666667  Inexact Rounded
dsdiv3023  divide        1 99999 -> 0.00001000011  Inexact Rounded
dsdiv3024  divide        1 999999 -> 0.000001000002  Inexact Rounded

