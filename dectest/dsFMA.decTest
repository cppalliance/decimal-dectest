dsfma0012  fma           1 -1 2 -> 1
dsfma0013  fma           2 -2 3 -> -1
dsfma0014  fma           9 -9 9 -> -72
dsfma0015  fma           1 1 -1 -> 0
dsfma0016  fma           1 1 -2 -> -1
dsfma0017  fma           2 2 -3 -> 1
dsfma0018  fma           9 9 -9 -> 72

