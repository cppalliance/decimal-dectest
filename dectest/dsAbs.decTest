dsabs014   abs           -0 -> 0
dsabs015   abs           -0.00 -> 0.00
dsabs016   abs           -00.0 -> 0.0
dsabs017   abs           -00.00 -> 0.00
dsabs018   abs           -00 -> 0

dsabs020   abs           -2000000 -> 2000000
dsabs021   abs           2000000 -> 2000000

dsabs030   abs           +0.1 -> 0.1
